<?xml version="1.0"?>
<sdf version="1.7">
  <world name="maze_world">
    <include>
      <uri>model://ground_plane</uri>
    </include>
    <include>
      <uri>model://sun</uri>
    </include>
    <!-- Simple maze walls -->
    <model name="maze_walls">
      <static>true</static>
      <link name="wall_1">
        <visual name="wall_1_visual">
          <geometry>
            <box>
              <size>2 0.1 0.5</size>
            </box>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
          </material>
        </visual>
        <pose>0 1 0.25 0 0 0</pose>
      </link>
      <link name="wall_2">
        <visual name="wall_2_visual">
          <geometry>
            <box>
              <size>2 0.1 0.5</size>
            </box>
          </geometry>
        </visual>
        <pose>0 -1 0.25 0 0 0</pose>
      </link>
      <link name="wall_3">
        <visual name="wall_3_visual">
          <geometry>
            <box>
              <size>0.1 2 0.5</size>
            </box>
          </geometry>
        </visual>
        <pose>1 0 0.25 0 0 0</pose>
      </link>
      <link name="wall_4">
        <visual name="wall_4_visual">
          <geometry>
            <box>
              <size>0.1 2 0.5</size>
            </box>
          </geometry>
        </visual>
        <pose>-1 0 0.25 0 0 0</pose>
      </link>
      <!-- Add more walls for a more complex maze -->
    </model>
  </world>
</sdf>

Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.5
      Cell Size: 1
      Class: rviz_default_plugins/Grid
      Color: 160;160;160
      Enabled: true
      Line Style:
        Line Width: 0.03
        Value: Lines
      Name: Grid
      Plane: XY
      Plane Cell Count: 40
      Reference Frame: map
      Value: true
    - Class: rviz_default_plugins/RobotModel
      Enabled: true
      Name: Robot
      Robot Description: robot_description
      Update Interval: 0
      Value: true
    - Alpha: 1
      Buffer Length: 10
      Class: rviz_default_plugins/TF
      Enabled: true
      Frame Timeout: 15
      Marker Scale: 1
      Name: TF
      Show Arrows: true
      Show Axes: true
      Show Names: true
      Tree: {}
      Update Interval: 0
      Value: true
    - Alpha: 0.8
      Class: rviz_default_plugins/Map
      Color Scheme: map
      Draw Behind: true
      Enabled: true
      Name: StaticMap
      Topic: /map
  Reliability Policy: Reliable
  Durability Policy: Transient Local
  History Policy: Keep Last
  Depth: 5
      Unreliable: false
      Use Timestamp: false
      Value: true
    - Alpha: 1
      Buffer Length: 1
      Class: rviz_default_plugins/Path
      Color: 255;200;0
      Enabled: true
      Head Diameter: 0.02
      Head Length: 0.02
      Length: 0.1
      Line Style: Lines
      Line Width: 0.02
      Name: MazeOccupancy
      Offset:
        X: 0
        Y: 0
        Z: 0
      Pose Style: None
      Radius: 0.02
      Shaft Diameter: 0.02
      Shaft Length: 0.05
      Topic: /maze_occupancy
      Value: true
    - Alpha: 1
      Buffer Length: 1
      Class: rviz_default_plugins/Path
      Color: 25;255;25
      Enabled: true
      Head Diameter: 0.08
      Head Length: 0.08
      Length: 0.3
      Line Style: Lines
      Line Width: 0.03
      Name: PlannedPath
      Offset:
        X: 0
        Y: 0
        Z: 0
      Pose Style: None
      Radius: 0.03
      Shaft Diameter: 0.04
      Shaft Length: 0.08
      Topic: /planned_path
      Value: true
    - Alpha: 1
      Class: rviz_default_plugins/Odometry
      Covariance: false
      Enabled: true
      Name: Odom
      Topic: /odom
      Value: true
    - Alpha: 1
      Axes Length: 0.6
      Axes Radius: 0.02
      Class: rviz_default_plugins/Pose
      Color: 255;25;25
      Enabled: true
      Head Length: 0.2
      Head Radius: 0.08
      Name: RobotPose
      Shaft Length: 0.3
      Shaft Radius: 0.05
      Shape: Arrow
      Topic: /robot_pose
      Value: true
  Enabled: true
  Global Options:
    Background Color: 48;48;48
    Default Light: true
    Fixed Frame: map
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
    - Class: rviz_default_plugins/SetInitialPose
    - Class: rviz_default_plugins/SetGoal
  Transformation: 0
  Value: true
Views:
  Current:
    Class: rviz_default_plugins/Orbit
    Distance: 8
    Enable Stereo Rendering:
      Stereo Eye Separation: 0.06
      Stereo Focal Distance: 1
      Swap Stereo Eyes: false
      Value: false
    Focal Point:
      X: 0
      Y: 0
      Z: 0
    Focal Shape Fixed Size: true
    Focal Shape Size: 0.05000000074505806
    Invert Z Axis: false
    Name: Current View
    Near Clip Distance: 0.009999999776482582
    Pitch: 0.5
    Target Frame: map
    Yaw: 0.2
  Saved: ~
Window Geometry:
  Displays:
    collapsed: false
  Height: 800
  Hide Left Dock: false
  Hide Right Dock: false
  QMainWindow State: 
  Width: 1200
  X: 100
  Y: 60

<?xml version="1.0"?>
<robot xmlns:xacro="http://wiki.ros.org/xacro">
    <gazebo>

        <plugin name="gz::sim::systems::DiffDrive" filename="gz-sim-diff-drive-system">
            <!-- <ros>
                    <namespace>/slambot</namespace>
                </ros> -->
            <!-- Wheel Information -->
            <left_joint>wheel_left_joint</left_joint>
            <right_joint>wheel_right_joint</right_joint>
            <!-- <wheel_separation value="${2*wheel_yoff}"/> -->
            <!-- <wheel_diameter value="${2*wheel_radius}"/> -->
            <wheel_separation>0.112</wheel_separation>
            <wheel_radius>0.034</wheel_radius>
            <odom_publish_frequency>50</odom_publish_frequency>
            <topic>cmd_vel</topic>

            <!-- Limits -->
            <max_linear_acceleration>10.0</max_linear_acceleration>
            <min_linear_acceleration>-10.0</min_linear_acceleration>
            <max_angular_acceleration>2</max_angular_acceleration>
            <min_angular_acceleration>-2</min_angular_acceleration>
            <max_linear_velocity>4</max_linear_velocity>
            <min_linear_velocity>-4</min_linear_velocity>
            <max_angular_velocity>1</max_angular_velocity>
            <min_angular_velocity>-1</min_angular_velocity>
            <!-- Output -->

            <publish_odom>false</publish_odom>
            <publish_tf>false</publish_tf>
        </plugin>

        <plugin filename="gz-sim-joint-state-publisher-system"
            name="gz::sim::systems::JointStatePublisher">
            <topic>joint_states</topic>
        </plugin>

